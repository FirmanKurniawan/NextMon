# NextMON (Next.js edition) - copy to .env.local for development
NEXTMON_DATA=./data            # SQLite db, encryption key, per-workspace files
NEXTMON_DEMO=1                 # force the simulated router for every router entry
#NEXTMON_SETUP_TOKEN=change-me # when set, /setup?token=change-me is required to create the first admin
#NEXTMON_BASE_URL=https://nextmon.example.com  # canonical origin: Host + Origin are validated against it
#NEXTMON_TRUSTED_PROXIES=10.0.0.5,172.18.0.0/16 # X-Forwarded-* honoured only from these peers (loopback is always trusted)
#NEXTMON_SESSION_IDLE_MIN=480
PORT=3000
HOSTNAME=127.0.0.1
